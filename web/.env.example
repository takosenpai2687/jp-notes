# Local development starts persistent Postgres automatically.
# Netlify injects NETLIFY_DB_URL and selects a separate database branch for previews.
# Do not copy a production database URL into a preview or a NEXT_PUBLIC_ variable.
#
# To deliberately use an existing database locally:
# NETLIFY_DB_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
#
# Optional: local database directory, never used for hosted persistence.
# TAKO_DEV_DB_DIR=./data/postgres
#
# Optional GA4 analytics. Leave unset to avoid loading Google analytics scripts.
# Public measurement ID, not an API secret. Set for Production builds only on Netlify.
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
#
# Youdao Zhiyun TTS (Japanese pronunciation for vocabulary). Secret — never use
# NEXT_PUBLIC_ or commit real values. Put them in an untracked .env.local here,
# or in Netlify environment variables for deployment.
# YOUDAO_APP_KEY=your_app_id
# YOUDAO_APP_SECRET=your_app_secret
# Optional: override the Japanese voice (defaults to "youkejiang", female).
# Other verified Japanese voices: yuantianjun (male), gongqishuai (male, 非常见语种).
# YOUDAO_JA_VOICE=youkejiang
# Browser audio cache revision. Bump when correcting catalog text or changing voice.
# This public value contains no secret. Netlify scope: Builds AND Functions.
# NEXT_PUBLIC_SPEECH_CACHE_VERSION=1
